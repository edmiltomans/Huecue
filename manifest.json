
{
  "manifest_version": 3,
  "name": "HueCue",
  "version": "0.1.0",
  "description": "A privacy-first extension that adds visual cues to colored text in Gmail.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/cues.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png"
}
  }
}
